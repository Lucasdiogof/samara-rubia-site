{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samara-rubia-site",
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/*", "!/_next/*", "!/images/*", "!/*.png", "!/*.ico", "!/*.svg", "!/*.webmanifest"],
  },
  "routes": [
    { "pattern": "samararubia.com", "custom_domain": true },
    { "pattern": "www.samararubia.com", "custom_domain": true },
  ],
}
